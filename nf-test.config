config {
    testsDir "tests"
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    // Container/conda engine is added on the command line, e.g.
    //   nf-test test --profile +docker          (CI, Linux)
    //   nf-test test --profile +mamba,+arm      (Apple Silicon Mac)
    profile "test"
}
