/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options (containers, conda, ext.args)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ── Tool containers & conda envs (alphabetical) ───────────────────────────

    withLabel: dada2 {
        conda     = 'bioconda::bioconductor-dada2=1.38.0 conda-forge::r-digest'
        container = 'biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    withLabel: fasttree {
        conda     = 'bioconda::fasttree=2.1.11'
        container = 'biocontainers/fasttree:2.1.11--hec16e2b_1'
    }

    withLabel: mafft {
        conda     = 'bioconda::mafft=7.520'
        container = 'biocontainers/mafft:7.520--hec16e2b_1'
    }

    withLabel: phyloseq {
        conda     = 'bioconda::bioconductor-phyloseq=1.54.0 r-phytools bioconda::bioconductor-biostrings r-dplyr r-ggplot2 r-tidyr r-forcats r-ggthemes bioconda::bioconductor-decontam'
        container = 'docker.io/barbarahelena/phyloseq:1.54.0'
    }

    withLabel: picrust2 {
        conda     = 'bioconda::picrust2=2.6.3'
        container = 'biocontainers/picrust2:2.6.3--pyhdfd78af_2'
    }

    withLabel: python {
        conda     = 'conda-forge::python=3.12.12'
        container = 'biocontainers/python:3.12.12'
    }

    withLabel: seqtk {
        conda     = 'bioconda::seqtk=1.4'
        container = 'biocontainers/seqtk:1.4--h7132678_0'
    }

    withLabel: vsearch {
        conda     = 'bioconda::vsearch=2.32.0'
        container = 'biocontainers/vsearch:2.32.0--hd2be7a0_0'
    }

    // ── Per-process overrides ─────────────────────────────────────────────────

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
    }

}
